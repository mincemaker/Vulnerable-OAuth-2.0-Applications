extends layout

block content
  .container
    h2 Attacks
    h3 Unvalidated Redirect URL in authorization endpoint
    ul
      li
        | Steal authorization code: Please click
        a(href=stealCodeUrl) here
        | .
      li
        | Open redirect to example.com if clients are auto-approved: Please click
        a(href=openRedirectUrl) here
        | .
    h3 Weak Authorization Codes
    p
      | Bruteforce authorization codes at the token endpoint
      a(href='/guessauthzcode') here
      | .

    h3 Exchange authorization code with other credentials
    p 
      form(method='POST' action='/exchangewithothercreds')
        div.form-group
          label(for='code') Authorization Code:
          input#code.form-control(type='text', placeholder='15637', value='15637',name='code')
        div.form-group
          label(for='clientid') Client ID:
          input#clientid.form-control(type='text', placeholder='maliciousclient', value='maliciousclient', name='clientid')
        div.form-group
          label(for='secret') Client Secret:
          input#secret.form-control(type='password', placeholder='secret',  value='secret',name='secret')
        button.btn.btn-primary(type='submit') Submit

    h3 Weak handle-based access tokens
    p
       | Bruteforce access tokens at the resource server
       a(href='/guessaccesstokenatresourceserver') here
       | .

    h3 Hash Tokens
    p
      | Obtain tokens from a database via a NoSQL injection.
      a(href='/hashtokens') here

